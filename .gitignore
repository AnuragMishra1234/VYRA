# ============================================================
# VYRA Git Ignore Rules
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Datasets & Large Data Files (Protecting raw and processed data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/metadata/*
!data/metadata/.gitkeep

# Common Raw Data Formats
*.bag
*.csv
*.mat
*.h5
*.hdf5
*.parquet
*.feather
*.zip
*.tar.gz
*.tar

# Model Checkpoints & Serialized Weights
models/checkpoints/*
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.bin

# Research Results & Generated Outputs
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep
!results/processed/v_s3a_playback_cache.parquet
!results/processed/phase5_master_results.json
results/figures/*
!results/figures/.gitkeep
!results/figures/*.png
results/tables/*
!results/tables/.gitkeep
!results/tables/*.json

# IDEs & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
